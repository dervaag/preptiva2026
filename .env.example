APP_ENV=development
SECRET_KEY=dev-secret-change-me
COOKIE_SECURE=false
# Exact HTTPS origin for a public reverse proxy/tunnel, without trailing slash.

PUBLIC_ORIGIN=
# Login limits persist in the database; IP buckets do not trust client X-Forwarded-For.

AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_IP_MAX_ATTEMPTS=50
AUTH_LOGIN_WINDOW_SECONDS=900
# A second browser/device is rejected while the existing session is active.

AUTH_IDLE_SECONDS=1800
AUTH_ABSOLUTE_SECONDS=43200
# Automatic cleanup: generated audio/cache by file age; sessions by completion/creation.

RETENTION_AUDIO_DAYS=7
RETENTION_HISTORY_DAYS=90
RETENTION_RECEIPT_DAYS=30
RETENTION_ENABLED=true
# Total request cap before multipart parsing; endpoint PDF/audio limits still apply.

MAX_REQUEST_BYTES=31457280
DATABASE_URL=
REDIS_URL=
AI_MOCK=false
OPENAI_API_KEY=
MODEL_FAST=gpt-4o-mini
MODEL_DEEP=gpt-4o
STT_PROVIDER=openai
STT_FALLBACK_PROVIDER=
STT_MODEL=gpt-4o-transcribe
# Sesi baru: transkripsi WebSocket, VAD, dan TTS streaming

REALTIME_VOICE_ENABLED=true
# Applies only to newly created sessions; existing sessions retain their engine.
# LangGraph requires Python 3.10+ (deployment uses Python 3.12).

ORCHESTRATION_ENGINE=legacy
VAD_SILENCE_MS=1200
VAD_THRESHOLD=0.5
TTS_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_HR=
ELEVENLABS_VOICE_USER=
ELEVENLABS_VOICE_MANAGER=
ELEVENLABS_MODEL_PREPARED=eleven_multilingual_v2
ELEVENLABS_MODEL_LIVE=eleven_multilingual_v2
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
# Only used for compatible *_v2_5 models; ignored by Multilingual v2.
ELEVENLABS_LANGUAGE_CODE=
TTS_PREPARED_TIMEOUT_SEC=60
TTS_LIVE_TIMEOUT_SEC=30
TTS_CACHE=true

MAX_SESSIONS_PER_HOUR=5
ANSWER_SECONDS_JUNIOR=90
ANSWER_SECONDS_MIDDLE=120
ANSWER_SECONDS_SENIOR=120
ANSWER_SECONDS_MANAGER=150
RETRY_LIMIT=2
MAX_FOLLOWUPS_ENABLED=true
FOLLOWUPS_DEMO=1
FOLLOWUPS_SHORT=2
FOLLOWUPS_STANDARD=3
# Total live response budget (LLM + TTS), starting after transcription.
RESPOND_TIMEOUT_SEC=60
