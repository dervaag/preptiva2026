# Local developer inspector only. Copy to .env.studio.
APP_ENV=development
COOKIE_SECURE=false
AI_MOCK=false
REDIS_URL=
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
ORCHESTRATION_ENGINE=langgraph
LANGSMITH_TRACING=false
LANGCHAIN_TRACING_V2=false
